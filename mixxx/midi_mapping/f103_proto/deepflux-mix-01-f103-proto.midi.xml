<?xml version="1.0" encoding="utf-8"?>
<MixxxMIDIPreset schemaVersion="1" mixxxVersion="2.5">
    <info>
        <name>DeepFlux MIX-01 F103 Proto</name>
        <author>Prathmesh07123</author>
        <description>Midi Mapping for the DeepFlux MIX-01 F103 Proto</description>
        <manual>deepflux_mix-01_f103_proto</manual>
    </info>

    <controller id = "MIX-01">
        <scriptfiles>
            <file functionprefix = "DeepFluxMIX01" filename = "deepflux-mix-01-f103-proto.js"/>
        </scriptfiles>

        <controls>

            <control>
                <description>BROWSE - rotate - Scroll tracklist/tree view</description>
                <group>[Library]</group>
                <key>MoveVertical</key>
                <status>0xB0</status>
                <midino>0x0A</midino>
                <options>
                    <SelectKnob/>
                </options>
            </control>

            <control>
                <description>BROWSE - press - Move cursor expand folder</description>
                <group>[Library]</group>
                <key>GoToItem</key>
                <status>0x90</status>
                <midino>0x3E</midino>
                <options>
                    <Normal/>
                </options>
            </control>

            <control>
                <description>BROWSE - press - Move cursor between track list and tree view</description>
                <group>[Library]</group>
                <key>DeepFluxMIX01.backButton</key>
                <status>0x90</status>
                <midino>0x4D</midino>
                <options>
                    <Script-Binding/>
                </options>
            </control>

            <control>
                <description>LOAD (DECK1) - press - Load a Track into Deck 1</description>
                <group>[Channel1]</group>
                <key>LoadSelectedTrack</key>
                <status>0x90</status>
                <midino>0x4C</midino>
                <options>
                    <Normal/>
                </options>
            </control>

            <!-- DECK-->

            <control>
                <description>PLAY/PAUSE (DECK1) - press - Play/Pause</description>
                <group>[Channel1]</group>
                <key>play</key>
                <status>0x90</status>
                <midino>0x3C</midino>
                <options>
                    <Normal/>
                </options>
            </control>

            <control>
                <description>CUE (DECK1) - press - Set/Call Cue, Back Cue</description>
                <group>[Channel1]</group>
                <key>cue_default</key>
                <status>0x90</status>
                <midino>0x3D</midino>
                <options>
                    <Normal/>
                </options>
            </control>
            

        </controls>

        <outputs>

            <output>
                <group>[Channel1]</group>
                <key>play_indicator</key>
                <status>0x90</status>  <!-- First byte sent to device -->
                <midino>0x0B</midino>  <!-- Second byte -->
                <on>0x7F</on>
                <minimum>0.5</minimum>
            </output>

            <!-- CUE -->
            <output>
                <group>[Channel1]</group>
                <key>cue_indicator</key>
                <status>0x90</status>
                <midino>0x0C</midino>
                <on>0x7F</on>
                <minimum>0.5</minimum>
            </output>

        </outputs>

    </controller>
</MixxxMIDIPreset>