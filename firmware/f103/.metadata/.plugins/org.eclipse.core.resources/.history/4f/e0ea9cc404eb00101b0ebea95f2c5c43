#include <drivers/gpio.h>
#include <stdint.h>
#include <stm32f1xx.h>



void GPIO_Init(void){

	//Enable GPIOA CLK
	RCC->APB2ENR |= RCC_APB2ENR_IOPAEN;
	RCC->APB2ENR |= (1 << 4);

	GPIOC->CRH &= ~(0xF << 20);
	GPIOC->CRH |= (0x2 << 20);

//--------------------- BUTTONS ----------------------

	// PA5 -> Browser/Track Button (Input Pull-Up)
	// PA6 -> CUE Button (Input Pull-Up)
	// PA7 -> PLAY Button (Input Pull-Up)

	// PA5
	GPIOA->CRL &= ~(0xF << 22);
	GPIOA->CRL |= GPIOA_CRL_PA5_IPU;

	// PA6
	GPIOA->CRL &= ~(0xF << 24);
	GPIOA->CRL |= GPIOA_CRL_PA6_IPU;

	// PA7
	GPIOA->CRL &= ~(0xF << 26);
	GPIOA->CRL |= GPIOA_CRL_PA7_IPU;

	//Enable Pull-ups
	GPIOA->ODR |= GPIOA_ODR_PA5;
	GPIOA->ODR |= GPIOA_ODR_PA6;
	GPIOA->ODR |= GPIOA_ODR_PA7;

//----------------------------------------------------


}


