#include <stdint.h>
#include <stdio.h>
#include <stm32f1xx.h>
#include "rcc.h"
#include "gpio.h"
#include "timer.h"
#include "button.h"





int main(void)
{
	RCC_72_Init();
	GPIO_Init();
	Button_Init();

	TIM3_Button_Init();

}

//================== ISR ==================

void TIM3_IRQHandler(void){

    if (TIM3->SR & TIM3_SR_UIF){

        TIM3->SR &= ~TIM3_SR_UIF;
        Button_Scan_1ms();
    }
}
