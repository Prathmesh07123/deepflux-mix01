/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{


  HAL_Init();

  SystemClock_Config();

  MX_GPIO_Init();
  MX_USB_DEVICE_Init();

  GPIO_Init();
  USART2_INIT();
  Button_Init();
  Encoder_Init();
  ADC_Init();

  TIM2_Encoder_Init();
  TIM3_ADC_Init();
  TIM4_Button_Init();

#ifdef DEBUG
	printf("Debugging Start...\n");
	fflush(stdout);
#endif

	button_event_t btn_evt;
	encoder_event_t enc_evt;
	adc_event_t adc_evt;


  while (1){

	  if(Button_GetEvent(&btn_evt)){

		  if(btn_evt.type == BUTTON_EVENT_PRESSED){
			  	switch(btn_evt.button){
	  				case BTN_ENCODER:
	  					USB_MIDI_NoteOn(0, 62, 100);
#ifdef DEBUG
	  					printf("Encode Button pressed\n");
	  					fflush(stdout);
#endif
	  					break;
	  				case BTN_CUE:
	  					USB_MIDI_NoteOn(0, 61, 100);
#ifdef DEBUG
	  					printf("CUE pressed\n");
	  					fflush(stdout);
#endif
	  					break;
					case BTN_PLAY:
						USB_MIDI_NoteOn(0, 60, 100);
#ifdef DEBUG
  						printf("Play pressed\n");
  						fflush(stdout);
#endif
  						break;
  					case BTN_COUNT:
  						break;
  				}
  			}
	  }

	  if(Encoder_GetEvent(&enc_evt)){

		  if(enc_evt.delta > 0){
			    USB_MIDI_CC(0, 10, 127);
#ifdef DEBUG
	  			printf("Encoder +1\n");
	  			fflush(stdout);
#endif

		  }
		  else{
			  	USB_MIDI_CC(0, 10, 0);
#ifdef DEBUG
	  			printf("Encoder -1\n");
	  			fflush(stdout);
#endif

		  }
	  }

	  if(ADC_GetEvent(&adc_evt)){

		  uint8_t midi_val = adc_to_midi(adc_evt.value);
		  if(USB_Tx_State == 0) {
		      USB_MIDI_CC(0, 1, midi_val); // safe: channel 0, CC1
		  }
#ifdef DEBUG
		  printf("Mapped ADC : %u\r\n", midi_val);
		  fflush(stdout);
#endif

	  }


  }

}

//================== ISR ==================

void TIM4_IRQHandler(void){

    if (TIM4->SR & TIM4_SR_UIF){

        TIM4->SR &= ~TIM4_SR_UIF;

        Button_Scan_1ms();
        Encoder_Scan_1ms();
    }
}

void ADC1_2_IRQHandler(void)
{
    if (ADC1->SR & ADC_SR_EOC)
    {
    	ADC_Scan_ISR();
        ADC1->SR &= ~ADC_SR_EOC;
    }
}

