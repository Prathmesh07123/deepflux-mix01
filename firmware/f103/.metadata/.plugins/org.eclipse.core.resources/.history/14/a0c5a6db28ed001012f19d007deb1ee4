	}

}

//================== ISR ==================

void TIM4_IRQHandler(void){

    if (TIM4->SR & TIM4_SR_UIF){

        TIM4->SR &= ~TIM4_SR_UIF;

        Button_Scan_1ms();
        Encoder_Scan_1ms();
    }
}

void ADC1_2_IRQHandler(void)
{
    if (ADC1->SR & ADC_SR_EOC)
    {
    	ADC_Scan_ISR();
        ADC1->SR &= ~ADC_SR_EOC;
    }
}
