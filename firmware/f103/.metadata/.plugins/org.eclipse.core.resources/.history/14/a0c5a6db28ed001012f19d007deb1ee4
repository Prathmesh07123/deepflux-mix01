uint8_t adc_to_midi(uint16_t adc);

uint8_t adc_to_midi(uint16_t adc){

	return (uint8_t)((adc * 127 + 2047) / 4095);
}


int main(void)
{
	RCC_72_Init();
	GPIO_Init();
	USART2_INIT();
	Button_Init();
	Encoder_Init();
	ADC_Init();

	TIM2_Encoder_Init();
	TIM3_ADC_Init();
	TIM4_Button_Init();
#ifdef DEBUG
	printf("Debugging Start...\n");
	fflush(stdout);
#endif

	button_event_t btn_evt;
	encoder_event_t enc_evt;
	adc_event_t adc_evt;

	while(1){

		if(Button_GetEvent(&btn_evt)){

			if(btn_evt.type == BUTTON_EVENT_PRESSED){
				switch(btn_evt.button){
					case BTN_ENCODER:
						printf("Encode Button pressed\n");
						fflush(stdout);
						break;
					case BTN_CUE:
						printf("CUE pressed\n");
						fflush(stdout);
						break;
					case BTN_PLAY:
						printf("Play pressed\n");
						fflush(stdout);
						break;
					case BTN_COUNT:
						break;
				}
			}

		}

		if(Encoder_GetEvent(&enc_evt)){

			if(enc_evt.delta > 0){
				printf("Encoder +1\n");
			}
			else{
				printf("Encoder -1\n");
			}
		}

		if(ADC_GetEvent(&adc_evt)){

			uint8_t midi_val = adc_to_midi(adc_evt.value);
			printf("Mapped ADC : %u\r\n", midi_val);
			fflush(stdout);
		}

