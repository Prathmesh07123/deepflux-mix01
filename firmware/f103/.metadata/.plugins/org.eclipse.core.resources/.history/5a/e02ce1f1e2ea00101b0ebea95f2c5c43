#include <stdint.h>
#include <stm32f1xx.h>
#include "gpio.h"



void GPIO_Init(void){

	//Enable GPIOA CLK
	RCC->APB2ENR |= RCC_APB2ENR_IOPAEN;

	// ---------------- BUTTONS ----------------
	// PA6 -> CUE Button (Input Pull-Up)
	// PA7 -> PLAY Button (Input Pull-Up)

	// PA6
	GPIOA->CRL &= ~(0xF << 24);
	GPIOA->CRL |= GPIOA_CRL_PA6_IPU;

	// PA7
	GPIOA->CRL &= ~(0xF << 26);
	GPIOA->CRL |= GPIOA_CRL_PA7_IPU;

	//Enable Pull-ups
	GPIOA->ODR |= GPIOA_ODR_PA6;


}


