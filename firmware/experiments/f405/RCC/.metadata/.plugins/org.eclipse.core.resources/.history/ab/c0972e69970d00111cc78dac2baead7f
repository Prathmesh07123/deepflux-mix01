#include <stdint.h>
#include <stm32f4xx.h>
#include "rcc.h"


//********************************** TIM2 REG DEFINE *********************************
#define RCC_APB1ENR_TIM2	(1 << 0)	//Timer 2 CLK Enable
#define TIM2_DIER_UIE		(1 << 0)	//Update Interrupt enable
#define TIM2_CR1_CEN		(1 << 0)	//Counter Enable
#define TIM2_SR_UIF			(1 << 0)	//Update Interrupt Flag
#define TIM2_EGR_UG			(1 << 0)
//************************************************************************************

//********************************** GPIO REG DEFINE *********************************
#define RCC_AHB1ENR_GPIOB	(1 << 1)
#define GPIOB_MODER_B2		(0b01 << 4)
//************************************************************************************



void gpio_init(void){
	RCC->AHB1ENR |= RCC_AHB1ENR_GPIOB;
	GPIOB->MODER &= ~(0b11 << 4);
	GPIOB->MODER |= GPIOB_MODER_B2;
}

void tim2_init(void){

	RCC->APB1ENR |= RCC_APB1ENR_TIM2;
	TIM2->CR1 &= ~TIM2_CR1_CEN;
	TIM2->PSC = 42000 - 1;
	TIM2->ARR = 500 - 1;

	TIM2->EGR |= TIM2_EGR_UG;
	TIM2->SR = 0;

	TIM2->DIER |= TIM2_DIER_UIE;
	NVIC_EnableIRQ(TIM2_IRQn);
	TIM2->CNT = 0;
	TIM2->CR1 |= TIM2_CR1_CEN;
}

int main(void)
{
	clock_168_Init();

	tim2_init();
	gpio_init();

	while(1){


	}

}

void TIM2_IRQHandler(void)
{
    if (TIM2->SR & TIM2_SR_UIF)
    {
        TIM2->SR &= ~TIM2_SR_UIF;

        GPIOB->ODR ^= (1 << 2);


    }
}
